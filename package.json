{
  "name": "primetrack-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:content && astro build",
    "preview": "astro preview",
    "check": "npm run check:content && npm run check:contrast && npm run check:placeholders",
    "check:content": "node scripts/check-content.mjs",
    "check:contrast": "node scripts/contrast-audit.mjs",
    "check:placeholders": "node scripts/placeholder-report.mjs",
    "assets:og": "node scripts/make-og-image.mjs",
    "assets:logo": "node scripts/make-logo-variant.mjs",
    "qa": "node scripts/qa-report.mjs",
    "astro": "astro",
    "check:gate4": "node scripts/gate4-coverage.mjs",
    "verify": "npm run build && npm run qa && npm run check:gate4"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "lucide-static": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  }
}
