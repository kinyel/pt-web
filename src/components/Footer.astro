---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { products, services, primeInfo, primeTools } from '../data/navigation.ts';
import { company, contact, socials, primeValues, certificatesPdf, countries } from '../data/company.ts';

const year = new Date().getFullYear();
const rwanda = countries.find((c) => c.code === 'RWA')!;

const socialIcons: Record<string, string> = {
  Instagram: 'instagram',
  'X (Twitter)': 'twitter',
  Facebook: 'facebook',
  LinkedIn: 'linkedin',
};

const columns = [
  { title: 'Products', items: products },
  { title: 'Services', items: services },
  { title: 'PrimeINFO', items: primeInfo },
  { title: 'PrimeTOOLS', items: primeTools },
];
---

<footer class="on-dark bg-ink-950 text-ink-400">
  <div class="container-prime py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,2fr)]">
      <!-- Company -->
      <div class="flex flex-col gap-6">
        <Logo tone="light" />
        <p class="max-w-sm text-small text-pretty">
          {company.positioningAlt}, delivering GPS tracking, video telematics and fleet management
          across Nigeria.
        </p>

        <div>
          <p class="text-label uppercase text-ink-300">Core values</p>
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
            {
              primeValues.map((value) => (
                <li class="text-small">
                  <span class="font-display font-semibold text-prime-500">{value.letter}</span>
                  <span class="ml-1.5 text-ink-300">{value.word}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <ul class="flex gap-3">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`PrimeTrack on ${social.label}`}
                  class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 text-ink-300 transition-colors hover:border-prime-500 hover:text-prime-400"
                >
                  <Icon name={socialIcons[social.label]} size={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Link columns + contact -->
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          columns.map((column) => (
            <nav aria-label={column.title}>
              <h2 class="text-label uppercase text-ink-300">{column.title}</h2>
              <ul class="mt-4 flex flex-col gap-2.5">
                {column.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener noreferrer' : undefined}
                      class="inline-flex items-center gap-1.5 text-small text-ink-300 transition-colors hover:text-prime-400"
                    >
                      {item.label}
                      {item.external && <Icon name="external-link" size={12} />}
                    </a>
                  </li>
                ))}
                {column.title === 'PrimeTOOLS' && (
                  <li>
                    <a
                      href={certificatesPdf.href}
                      class="inline-flex items-center gap-1.5 text-small text-ink-300 transition-colors hover:text-prime-400"
                    >
                      {certificatesPdf.label}
                      <Icon name="file-text" size={12} />
                    </a>
                  </li>
                )}
              </ul>
            </nav>
          ))
        }

        <div class="sm:col-span-2 lg:col-span-1">
          <h2 class="text-label uppercase text-ink-300">Contact</h2>
          <address class="mt-4 flex flex-col gap-3 not-italic text-small">
            <p class="text-ink-300">
              {contact.addressLines.map((line) => (<>{line}<br /></>))}
            </p>
            {
              contact.phones.map((phone) => (
                <a
                  href={`tel:${phone.tel}`}
                  class="inline-flex items-center gap-2 text-ink-300 transition-colors hover:text-prime-400"
                >
                  <Icon name="phone" size={15} />
                  {phone.display}
                </a>
              ))
            }
            <a
              href={`mailto:${contact.email}`}
              class="inline-flex items-center gap-2 break-all text-ink-300 transition-colors hover:text-prime-400"
            >
              <Icon name="mail" size={15} />
              {contact.email}
            </a>
            <a
              href={rwanda.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-ink-300 transition-colors hover:text-prime-400"
            >
              <Icon name="map-pin" size={15} />
              Rwanda office
              <Icon name="external-link" size={12} />
            </a>
          </address>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div
      class="container-prime flex flex-col gap-4 py-6 text-small md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} {company.name}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-ink-400">
        <li class="flex items-center gap-1.5">
          <Icon name="badge-check" size={14} class="text-prime-500" />NCC-licensed
        </li>
        <li class="flex items-center gap-1.5">
          <Icon name="badge-check" size={14} class="text-prime-500" />FRSC-licensed Speed Limiter vendor
        </li>
        <li class="flex items-center gap-1.5">
          <Icon name="shield-check" size={14} class="text-prime-500" />3-year warranty
        </li>
      </ul>
    </div>
  </div>
</footer>
