---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  tone?: 'light' | 'dark';
  size?: 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  tone = 'light',
  size = 'md',
  external = false,
  class: className = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors duration-[var(--duration-base)] ease-[var(--ease-prime)] whitespace-nowrap';
const sizes = {
  md: 'px-5 py-2.5 text-small min-h-11',
  lg: 'px-7 py-3.5 text-body min-h-12',
};
const variants = {
  /* Black type on the brand orange, not white: white on #ff7000 is 2.8:1 and
     fails WCAG AA outright, and prime-600 with white is still only 3.7:1.
     Black is 7.2:1 — and it is what the logo itself does. This is the one
     colour that intentionally differs from the pre-blue build. */
  primary: 'bg-prime-500 text-ink-950 hover:bg-prime-400 active:bg-prime-600',
  secondary:
    tone === 'dark'
      ? 'border border-white/25 text-white hover:border-white/60 hover:bg-white/5'
      : 'border border-ink-200 text-ink-900 hover:border-ink-400 hover:bg-ink-50',
  ghost:
    tone === 'dark'
      ? 'text-white hover:text-prime-300'
      : 'text-ink-900 hover:text-prime-700',
};
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a
  href={href}
  rel={rel}
  target={target}
  class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
>
  <slot />
</a>
