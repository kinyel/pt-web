---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'tech' | 'ghost';
  tone?: 'light' | 'dark';
  size?: 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  tone = 'light',
  size = 'md',
  external = false,
  class: className = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors duration-[var(--duration-base)] ease-[var(--ease-prime)] whitespace-nowrap';
const sizes = {
  md: 'px-5 py-2.5 text-small min-h-11',
  lg: 'px-7 py-3.5 text-body min-h-12',
};
/**
 * Primary sets BLACK type on the brand orange, not white. White on #ff7000 is
 * 2.8:1 and fails WCAG AA outright; black is 7.6:1 — and it is what the logo
 * itself does. See scripts/contrast-audit.mjs.
 */
const variants = {
  primary: 'bg-prime-500 text-ink-950 hover:bg-prime-400 active:bg-prime-600',
  secondary:
    tone === 'dark'
      ? 'border border-white/25 text-white hover:border-azure-400 hover:bg-azure-400/10'
      : 'border border-ink-200 text-ink-900 hover:border-azure-500 hover:bg-azure-50',
  /* Technology voice: analytics, API and data pages. */
  tech:
    tone === 'dark'
      ? 'bg-azure-400 text-ink-950 hover:bg-azure-300 active:bg-azure-500'
      : 'bg-azure-700 text-white hover:bg-azure-600 active:bg-azure-800',
  ghost:
    tone === 'dark'
      ? 'text-white hover:text-azure-300'
      : 'text-ink-900 hover:text-azure-700',
};
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a
  href={href}
  rel={rel}
  target={target}
  class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
>
  <slot />
</a>
