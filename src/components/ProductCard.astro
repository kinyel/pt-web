---
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  descriptor: string;
  icon: string;
  /** Featured cards span two columns and carry a longer blurb. */
  featured?: boolean;
  blurb?: string;
  external?: boolean;
  class?: string;
}

const {
  href,
  label,
  descriptor,
  icon,
  featured = false,
  blurb,
  external = false,
  class: className = '',
} = Astro.props;
---

<a
  href={href}
  rel={external ? 'noopener noreferrer' : undefined}
  target={external ? '_blank' : undefined}
  class={`group relative flex flex-col gap-4 rounded-panel border border-ink-200 bg-white p-6 transition duration-[var(--duration-base)] ease-[var(--ease-prime)] hover:-translate-y-1 hover:border-prime-300 hover:shadow-lift active:translate-y-0 active:shadow-card md:p-8 ${
    featured ? 'sm:col-span-2' : ''
  } ${className}`}
>
  <span
    class="flex h-11 w-11 items-center justify-center rounded-full bg-prime-50 text-prime-600 transition-colors duration-[var(--duration-base)] group-hover:bg-prime-500 group-hover:text-white"
  >
    <Icon name={icon} size={20} />
  </span>

  <div class="flex flex-col gap-2">
    <h3 class="flex items-center gap-1.5 text-h4 text-ink-950">
      {label}
      {external && <Icon name="external-link" size={14} class="text-ink-400" />}
    </h3>
    <p class="text-small text-ink-600">{descriptor}</p>
    {featured && blurb && <p class="text-small text-ink-600 text-pretty">{blurb}</p>}
  </div>

  <span
    class="mt-auto inline-flex items-center gap-1.5 text-small font-semibold text-prime-700 transition-transform duration-[var(--duration-base)] group-hover:translate-x-0.5"
  >
    {external ? 'Visit site' : 'Explore'}
    <Icon name="arrow-right" size={16} />
  </span>
</a>
