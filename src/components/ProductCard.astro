---
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  descriptor: string;
  icon: string;
  /** Featured cards span two columns and carry a longer blurb. */
  featured?: boolean;
  blurb?: string;
  external?: boolean;
  /**
   * Which voice the card speaks in. `brand` (orange) is for hardware and
   * products; `tech` (blue) is for the data, analytics and integration layer.
   * See the colour usage rule at the top of styles/global.css.
   */
  accent?: 'brand' | 'tech';
  class?: string;
}

const {
  href,
  label,
  descriptor,
  icon,
  featured = false,
  blurb,
  external = false,
  accent = 'brand',
  class: className = '',
} = Astro.props;

/* group-hover previously put white on #ff7000 — 2.8:1, an AA failure. Black on
   orange is 7.2:1 and matches the logo. */
const accents = {
  brand: {
    border: 'hover:border-prime-300',
    chip: 'bg-prime-50 text-prime-600 group-hover:bg-prime-500 group-hover:text-ink-950',
    link: 'text-prime-700',
  },
  tech: {
    border: 'hover:border-azure-400',
    chip: 'bg-azure-50 text-azure-700 group-hover:bg-azure-600 group-hover:text-white',
    link: 'text-azure-700',
  },
}[accent];
---

<a
  href={href}
  rel={external ? 'noopener noreferrer' : undefined}
  target={external ? '_blank' : undefined}
  class={`group relative flex flex-col gap-4 rounded-panel border border-ink-200 bg-white p-6 transition duration-[var(--duration-base)] ease-[var(--ease-prime)] hover:-translate-y-0.5 hover:shadow-lift md:p-8 ${accents.border} ${
    featured ? 'sm:col-span-2' : ''
  } ${className}`}
>
  <span
    class={`flex h-11 w-11 items-center justify-center rounded-full transition-colors duration-[var(--duration-base)] ${accents.chip}`}
  >
    <Icon name={icon} size={20} />
  </span>

  <div class="flex flex-col gap-2">
    <h3 class="flex items-center gap-1.5 text-h4 text-ink-950">
      {label}
      {external && <Icon name="external-link" size={14} class="text-ink-400" />}
    </h3>
    <p class="text-small text-ink-600">{descriptor}</p>
    {featured && blurb && <p class="text-small text-ink-600 text-pretty">{blurb}</p>}
  </div>

  <span
    class={`mt-auto inline-flex items-center gap-1.5 text-small font-semibold transition-transform duration-[var(--duration-base)] group-hover:translate-x-0.5 ${accents.link}`}
  >
    {external ? 'Visit site' : 'Explore'}
    <Icon name="arrow-right" size={16} />
  </span>
</a>
