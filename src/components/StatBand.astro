---
import { stats } from '../data/company.ts';

interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'dark', class: className = '' } = Astro.props;

const valueTone = tone === 'dark' ? 'text-white' : 'text-ink-950';
const labelTone = tone === 'dark' ? 'text-ink-400' : 'text-ink-500';
const ruleTone = tone === 'dark' ? 'divide-white/10' : 'divide-ink-200';
---

<!-- The only four numeric claims permitted on this site (inventory §5).
     The value reads first, but <dt> must precede <dd> in the markup for the
     definition list to be valid, so flex-col-reverse handles the visual order. -->
<dl class={`grid grid-cols-2 gap-y-10 sm:divide-x lg:grid-cols-4 ${ruleTone} ${className}`}>
  {
    stats.map((stat) => (
      <div class="flex flex-col-reverse items-center gap-2 px-4 text-center">
        <dt class={`text-small ${labelTone}`}>{stat.label}</dt>
        <dd class={`text-stat font-display ${valueTone}`}>{stat.value}</dd>
      </div>
    ))
  }
</dl>
