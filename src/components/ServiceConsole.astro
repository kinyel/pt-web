---
/**
 * Homepage services section a scroll-driven cylinder.
 *
 * PAIRED WITH, NOT COPIED FROM, THE PRODUCT SPIRAL
 * Both sections are scroll-driven, both pin a stage and sync a list beside it,
 * and both share the same driver discipline. They are deliberately different
 * in what actually moves:
 *
 *   products  six small hardware cards on a tight helix  they rotate AND
 *             climb, which is what makes it a staircase.
 *   services  three large dashboards on a wide, shallow drum  they only
 *             rotate. No vertical travel at all, so the eye reads a turning
 *             cylinder rather than a rising spiral.
 *
 * Cool where the spiral is warm, three items where it has six, and a display
 * big enough to actually read rather than a card to glance at.
 *
 * GEOMETRY
 * A panel only sits ON a cylinder if it is a chord of one: W = 2R sin(θ/2).
 * The display column is 33rem (528px), so at a 50° pitch R = 625px; 620px
 * gives a 524px chord under a 528px panel. The pitch is deliberately wider
 * than a subtle arc and the perspective deliberately short (1200px), because
 * the brief asks for the rotation to be obvious — a long lens would flatten
 * it back into a slide.
 *
 * PERFORMANCE
 * The driver is a deferred module that does nothing until the section is near
 * the viewport, then does one rect read and one custom-property write per
 * frame. Every panel derives its own angle from that single value in CSS, so
 * three panels cost the same scroll work as one.
 */
import Icon from './Icon.astro';
import { services } from '../data/navigation.ts';

interface Props {
  id?: string;
}
const { id } = Astro.props;

/* The three internal services. vRAS is a Rwanda property and not one of the
   three this section is about — see the note in navigation.ts. */
const items = services.filter((service) => !service.external);

/* Gauge geometry, computed once so the arc and its overlay cannot drift.
   220° sweep, opening at the bottom. */
const CX = 170;
const CY = 138;
const R = 78;
const SWEEP = 220;
const START = 160;
const pt = (deg: number) => [
  (CX + R * Math.cos((deg * Math.PI) / 180)).toFixed(1),
  (CY + R * Math.sin((deg * Math.PI) / 180)).toFixed(1),
];
const [x1, y1] = pt(START);
const [x2, y2] = pt(START + SWEEP);
const ARC = `M ${x1} ${y1} A ${R} ${R} 0 1 1 ${x2} ${y2}`;
const ARC_LEN = (2 * Math.PI * R * SWEEP) / 360;
/* Where the gauge needle sits. A drawn value, not a measured one. */
const SCORE = 86;
const ARC_FILLED = ARC_LEN * (1 - SCORE / 100);
const [dotX, dotY] = pt(START + SWEEP * (SCORE / 100));

/* Driver-monitoring sub-metrics. The names are real capabilities; the bar
   lengths are illustrative. */
const behaviours = [
  { label: 'Harsh braking', width: 34 },
  { label: 'Overspeed', width: 21 },
  { label: 'Cornering', width: 47 },
];

/* API endpoints — generic system categories, not named products. */
const endpoints = [
  { label: 'ERP', y: 40 },
  { label: 'Fleet ops', y: 101 },
  { label: 'Billing', y: 162 },
];

const flows = endpoints.map(
  (endpoint, i) => `M 122 101 C 168 101, 180 ${endpoint.y}, 226 ${endpoint.y}`,
);

/* Analytics sparkline. Drawn shape, not plotted data. */
const SPARK =
  'M 22 94 C 52 90, 66 64, 96 68 S 136 42, 164 54 S 202 32, 232 40 S 280 24, 312 30';

const tiles = [
  { label: 'Utilisation', bars: [10, 16, 13, 22] },
  { label: 'Idle time', bars: [20, 14, 17, 9] },
  { label: 'Distance', bars: [12, 18, 15, 23] },
];---

<section id={id} class="svc" data-svc style={`--count:${items.length}`}>
  <div class="svc-track" data-svc-track>
    <div class="svc-viewport">
      <div class="container-prime svc-layout">
        <!-- ================= Pinned index ================= -->
        <div class="svc-menu">
          <span class="eyebrow">Services</span>
          <h2 class="svc-title">The intelligence layer on top of the hardware</h2>
          <p class="svc-lead">
            Trackers collect the data. These services turn it into decisions your operation can act
            on.
          </p>

          <ul class="svc-rail" role="list">
            {
              items.map((item, i) => (
                <li class="svc-rail-item">
                  <a class="svc-row" data-svc-link data-i={i} href={item.href}>
                    <span class="svc-row-index">{String(i + 1).padStart(2, '0')}</span>
                    <span class="svc-row-icon">
                      <Icon name={item.icon!} size={19} />
                    </span>
                    <span class="svc-row-text">
                      <span class="svc-row-label">{item.label}</span>
                      <span class="svc-row-desc">{item.descriptor}</span>
                    </span>
                    <span class="svc-row-arrow">
                      <Icon name="arrow-right" size={16} />
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- ================= Rotating stage ================= -->
        <div class="svc-stage">
          {/* The axis the displays turn around. Opaque panels cover it at rest,
              so what shows is the glow overhanging above and below — until a
              panel turns away and reveals the whole core. */}
          <div class="svc-spine" aria-hidden="true">
            <span class="svc-spine-line"></span>
            <span class="svc-ripple" style="--delay:0s"></span>
            <span class="svc-ripple" style="--delay:-2.3s"></span>
            <span class="svc-dot"></span>
          </div>

          <div class="svc-drum" data-svc-drum>
            {
              items.map((item, i) => (
                <a
                  class="svc-panel"
                  data-svc-item
                  data-i={i}
                  style={`--i:${i}`}
                  href={item.href}
                  aria-label={`${item.label}: open the full page`}
                >
                  <div class="svc-screen">
                    <div class="svc-screen-bar">
                      <span class="svc-live" />
                      <span class="svc-screen-title">{item.label}</span>
                      <span class="svc-screen-open">
                        Open
                        <Icon name="arrow-right" size={13} />
                      </span>
                    </div>

        {/* ---------- 1. Driver Monitoring: score gauge ---------- */}
                        {i === 0 && (
                          <svg class="svc-viz" viewBox="0 0 340 232" role="presentation" focusable="false">
                            <path d={ARC} class="svc-gauge-track" />
                            <path
                              d={ARC}
                              class="svc-gauge-value"
                              style={`--arc:${ARC_LEN.toFixed(1)}; --arc-offset:${ARC_FILLED.toFixed(1)}`}
                            />
                            {/* Radar-style sweep: a short bright dash running the arc.
                                It moves without implying the reading changed. */}
                            <path
                              d={ARC}
                              class="svc-gauge-sweep"
                              style={`--arc:${ARC_LEN.toFixed(1)}`}
                            />
                            <circle cx={dotX} cy={dotY} r="6.5" class="svc-gauge-dot" />

                            <text x={CX} y={CY - 4} class="svc-gauge-score">{SCORE}</text>
                            <text x={CX} y={CY + 20} class="svc-gauge-cap">Driver score</text>

                            {behaviours.map((behaviour, b) => (
                              <>
                                <text x="22" y={186 + b * 20} class="svc-bar-label">
                                  {behaviour.label}
                                </text>
                                <rect x="150" y={178 + b * 20} width="168" height="6" rx="3" class="svc-bar-track" />
                                <rect
                                  x="150"
                                  y={178 + b * 20}
                                  width={behaviour.width * 1.68}
                                  height="6"
                                  rx="3"
                                  class="svc-bar-fill"
                                />
                              </>
                            ))}
                          </svg>
                        )}

                        {/* ---------- 2. API Integration: data-flow diagram ---------- */}
                        {i === 1 && (
                          <svg class="svc-viz" viewBox="0 0 340 232" role="presentation" focusable="false">
                            {flows.map((d, f) => (
                              <>
                                <path d={d} class="svc-flow-track" />
                                <path d={d} class="svc-flow-packet" style={`--delay:${-f * 1.6}s`} />
                              </>
                            ))}

                            <rect x="14" y="79" width="108" height="44" rx="12" class="svc-node-source" />
                            <text x="68" y="106" class="svc-node-label svc-node-label-source">
                              PrimeTrack
                            </text>

                            {endpoints.map((endpoint) => (
                              <>
                                <rect
                                  x="226"
                                  y={endpoint.y - 21}
                                  width="100"
                                  height="42"
                                  rx="12"
                                  class="svc-node-target"
                                />
                                <text x="276" y={endpoint.y + 5} class="svc-node-label">
                                  {endpoint.label}
                                </text>
                              </>
                            ))}

                            <text x="14" y="212" class="svc-bar-label">REST API · webhooks</text>
                          </svg>
                        )}

                        {/* ---------- 3. Fleet Analytics: chart + metric tiles ---------- */}
                        {i === 2 && (
                          <svg class="svc-viz" viewBox="0 0 340 232" role="presentation" focusable="false">
                            <defs>
                              <linearGradient id="svc-area" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#3b6fe8" stop-opacity="0.20" />
                                <stop offset="100%" stop-color="#3b6fe8" stop-opacity="0" />
                              </linearGradient>
                            </defs>

                            {[38, 66, 94].map((y) => (
                              <line x1="22" y1={y} x2="318" y2={y} class="svc-grid-line" />
                            ))}

                            <path d={`${SPARK} L 312 108 L 22 108 Z`} fill="url(#svc-area)" />
                            <path d={SPARK} class="svc-spark" />
                            <path d={SPARK} class="svc-spark-run" />
                            <circle cx="312" cy="30" r="10" class="svc-spark-halo" />
                            <circle cx="312" cy="30" r="5" class="svc-spark-dot" />

                            {tiles.map((tile, t) => (
                              <>
                                <rect x={22 + t * 101} y="134" width="94" height="76" rx="12" class="svc-tile" />
                                <text x={34 + t * 101} y="154" class="svc-tile-label">
                                  {tile.label}
                                </text>
                                {tile.bars.map((h, b) => (
                                  <rect
                                    x={34 + t * 101 + b * 18}
                                    y={196 - h}
                                    width="10"
                                    height={h}
                                    rx="3"
                                    class={b === tile.bars.length - 1 ? 'svc-tile-bar-key' : 'svc-tile-bar'}
                                  />
                                ))}
                              </>
                            ))}
                          </svg>
                        )}
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ------------------------------------------------------------------ shell */
  .svc {
    --svc-arc-pitch: 50deg;   /* angular pitch between adjacent displays */
    --svc-radius: 620px;      /* chord-matched to the 33rem display: 524px */
    --svc-persp: 1200px;      /* short lens on purpose — the turn must read */
    --svc-scroll-per-item: 78vh;

    background-color: var(--color-white);
    background-image:
      radial-gradient(44% 36% at 88% 2%, rgb(59 111 232 / 0.05) 0%, transparent 72%),
      linear-gradient(to bottom, var(--color-ink-50) 0%, var(--color-white) 46%);
    /* A turning panel swings well past the column. `clip` rather than `hidden`:
       hidden computes overflow-y to auto, which would silently break the
       sticky pinning below. */
    overflow-x: clip;
  }

  .svc-track { padding-block: 4rem; }
  @media (min-width: 48rem) {
    .svc-track { padding-block: 5.5rem; }
  }

  .svc-title {
    margin-top: 1rem;
    font-size: var(--text-h2);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-ink-950);
  }
  .svc-lead {
    margin-top: 0.875rem;
    max-width: 34rem;
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-ink-600);
    text-wrap: pretty;
  }
  .svc-hint {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.75rem;
    font-size: var(--text-small);
    color: var(--color-ink-500);
  }

  /* ------------------------------------------------------------------- rail */
  .svc-rail {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .svc-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1.0625rem 1.25rem;
    border: 1px solid var(--color-ink-200);
    border-radius: var(--radius-card);
    background-image: linear-gradient(180deg, var(--color-ink-50), var(--color-ink-100));
    box-shadow: 0 6px 16px -12px rgb(8 9 11 / 0.22);
    text-decoration: none;
    transition:
      background-color var(--duration-base) var(--ease-prime),
      border-color var(--duration-base) var(--ease-prime),
      box-shadow var(--duration-base) var(--ease-prime),
      transform var(--duration-base) var(--ease-prime),
      color var(--duration-base) var(--ease-prime);
  }

  /* The selected marker: a pill that grows into place at the card's edge. */
  .svc-row::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 50%;
    height: 54%;
    width: 3px;
    border-radius: 999px;
    background-color: var(--color-prime-500);
    opacity: 0;
    transform: translateY(-50%) scaleY(0.3);
    transition:
      opacity var(--duration-base) var(--ease-prime),
      transform var(--duration-base) var(--ease-prime);
  }

  .svc-row-index {
    flex-shrink: 0;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-ink-500);
    transition: color var(--duration-base) var(--ease-prime);
  }
  .svc-row-icon {
    display: flex;
    height: 2.375rem;
    width: 2.375rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background-color: var(--color-white);
    color: var(--color-data-600);
    transition:
      background-color var(--duration-base) var(--ease-prime),
      color var(--duration-base) var(--ease-prime);
  }
  .svc-row-text { display: flex; min-width: 0; flex-direction: column; gap: 0.125rem; }
  .svc-row-label {
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--color-ink-900);
    transition: color var(--duration-base) var(--ease-prime);
  }
  .svc-row-desc { font-size: var(--text-small); line-height: 1.45; color: var(--color-ink-600); }
  .svc-row-arrow {
    margin-left: auto;
    display: flex;
    flex-shrink: 0;
    color: var(--color-ink-500);
    transition:
      color var(--duration-base) var(--ease-prime),
      transform var(--duration-base) var(--ease-prime);
  }

  /* The active card. Driven by scroll on desktop and by which card is in view
     on a phone — the same attribute either way, so the styling is written once. */
  .svc-row[data-current] {
    background-color: var(--color-white);
    background-image: none;
    border-color: var(--color-prime-300);
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgb(255 112 0 / 0.32),
      0 14px 28px -14px rgb(8 9 11 / 0.28);
  }
  .svc-row[data-current]::before { opacity: 1; transform: translateY(-50%) scaleY(1); }
  .svc-row[data-current] .svc-row-label { color: var(--color-ink-950); }
  .svc-row[data-current] .svc-row-index { color: var(--color-prime-800); }
  .svc-row[data-current] .svc-row-icon {
    background-color: var(--color-prime-50);
    color: var(--color-prime-800);
  }
  .svc-row[data-current] .svc-row-arrow { color: var(--color-prime-800); }

  @media (hover: hover) {
    .svc-row:hover { border-color: var(--color-prime-300); }
    .svc-row:hover .svc-row-arrow { transform: translateX(3px); }
  }

  /* ------------------------------------------------------------------ screen */
  .svc-panel { display: block; text-decoration: none; }

  .svc-screen {
    overflow: hidden;
    border: 1px solid var(--color-ink-200);
    border-radius: var(--radius-panel);
    background-color: var(--color-white);
    box-shadow: 0 20px 48px -28px rgb(8 9 11 / 0.3);
  }
  .svc-screen-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-ink-100);
    background-color: var(--color-ink-50);
    padding: 0.625rem 1rem;
  }
  .svc-screen-title {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }
  .svc-screen-open {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-label);
    font-weight: 700;
    color: var(--color-prime-700);
  }
  .svc-live {
    height: 0.4375rem;
    width: 0.4375rem;
    flex-shrink: 0;
    border-radius: 999px;
    background-color: var(--color-prime-500);
  }
  .svc-viz { display: block; width: 100%; height: auto; padding: 0.5rem; max-height: 26rem; }
  /* --------------------------------------------------------- viz: shared */
  .svc-bar-label,
  .svc-tile-label,
  .svc-node-label,
  .svc-gauge-cap {
    font-family: var(--font-sans);
    fill: var(--color-ink-500);
    font-size: 11px;
  }
  .svc-bar-track { fill: var(--color-ink-100); }
  .svc-bar-fill { fill: var(--color-data-500); }

  /* ---------------------------------------------------------- viz: gauge */
  .svc-gauge-track {
    fill: none;
    stroke: var(--color-ink-100);
    stroke-width: 13;
    stroke-linecap: round;
  }
  .svc-gauge-value {
    fill: none;
    stroke: var(--color-data-500);
    stroke-width: 13;
    stroke-linecap: round;
    stroke-dasharray: var(--arc);
    stroke-dashoffset: var(--arc-offset);
  }
  .svc-gauge-sweep {
    fill: none;
    stroke: var(--color-white);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 20 calc(var(--arc) - 20);
    stroke-dashoffset: 0;
    opacity: 0.55;
  }
  .svc-gauge-dot {
    fill: var(--color-prime-500);
    stroke: var(--color-white);
    stroke-width: 3;
  }
  .svc-gauge-score {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    fill: var(--color-ink-950);
    text-anchor: middle;
  }
  .svc-gauge-cap {
    text-anchor: middle;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 10px;
  }

  /* ----------------------------------------------------------- viz: flow */
  .svc-flow-track {
    fill: none;
    stroke: var(--color-data-200);
    stroke-width: 1.5;
  }
  .svc-flow-packet {
    fill: none;
    stroke: var(--color-data-500);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 5 999;
    stroke-dashoffset: -40;
  }
  .svc-node-source {
    fill: var(--color-prime-50);
    stroke: var(--color-prime-500);
    stroke-width: 1.5;
  }
  .svc-node-target {
    fill: var(--color-data-50);
    stroke: var(--color-data-300);
    stroke-width: 1.5;
  }
  .svc-node-label {
    text-anchor: middle;
    font-weight: 700;
    fill: var(--color-data-700);
  }
  .svc-node-label-source { fill: var(--color-prime-700); }

  /* ------------------------------------------------------ viz: analytics */
  .svc-grid-line {
    stroke: var(--color-ink-100);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .svc-spark {
    fill: none;
    stroke: var(--color-data-500);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .svc-spark-run {
    fill: none;
    stroke: var(--color-white);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 16 999;
    stroke-dashoffset: -60;
    opacity: 0.8;
  }
  .svc-spark-dot {
    fill: var(--color-prime-500);
    stroke: var(--color-white);
    stroke-width: 2.5;
  }
  .svc-spark-halo {
    fill: none;
    stroke: var(--color-prime-500);
    stroke-width: 1.5;
    opacity: 0.28;
  }
  .svc-tile {
    fill: var(--color-ink-50);
    stroke: var(--color-ink-100);
    stroke-width: 1;
  }
  .svc-tile-bar { fill: var(--color-data-200); }
  .svc-tile-bar-key { fill: var(--color-data-500); }

  /* ---------------------------------------------------------------- motion */
  @media (prefers-reduced-motion: no-preference) {
    .svc-gauge-sweep { animation: svc-arc-sweep 7s linear infinite; }
    .svc-flow-packet {
      animation: svc-packet 3.4s cubic-bezier(0.5, 0, 0.5, 1) infinite;
      animation-delay: var(--delay);
    }
    .svc-spark-run { animation: svc-spark-run 6s linear infinite; }
    .svc-spark-halo {
      transform-box: fill-box;
      transform-origin: center;
      animation: svc-halo 3.2s ease-out infinite;
    }
  }

  @keyframes svc-arc-sweep {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: calc(var(--arc) * -1); }
  }
  @keyframes svc-packet {
    from { stroke-dashoffset: 0; opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    to { stroke-dashoffset: -175; opacity: 0; }
  }
  @keyframes svc-spark-run {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -420; }
  }
  @keyframes svc-halo {
    0% { transform: scale(0.7); opacity: 0.45; }
    70% { opacity: 0; }
    100% { transform: scale(2.1); opacity: 0; }
  }

  /* ======================================================================
     STATIC BASELINE — reduced motion, no JavaScript, or a driver that never
     starts. All three services are visible, readable and clickable, stacked
     one after another. Nothing is rotated, nothing is hidden, and the section
     is a plain list of three links. Every rule that moves anything lives
     behind [data-on], which only the driver sets.
     ====================================================================== */
  .svc-layout { display: flex; flex-direction: column; gap: 2.5rem; }
  .svc-stage { display: flex; flex-direction: column; gap: 1.25rem; }
  .svc-drum { display: flex; flex-direction: column; gap: 1.25rem; }
  .svc-spine { display: none; }

  /* ======================================================================
     MOBILE, DRIVEN — a stacked read with a synced indicator.

     No pinning and no cylinder here. The product spiral already pins and
     rotates on a phone; doing it twice on one page would be the same trick
     told twice, and a 375px-wide drum is a worse way to read a dashboard than
     simply scrolling to it. Instead the rail becomes a sticky strip of three
     numbered pills that tracks which display is on screen, and tapping a pill
     jumps to that display.
     ====================================================================== */
  /* `display: contents` lifts the rail out of .svc-menu and makes it a direct
     child of .svc-layout. Without this the pill strip can only stick for as
     long as .svc-menu is on screen — which is its own height — so it scrolls
     away the moment the first display arrives. Its sticky container has to be
     the element that spans the whole section. */
  .svc[data-on] .svc-menu { display: contents; }

  .svc[data-on] .svc-rail {
    position: sticky;
    /* Just under the mobile header, which is 65px and sticky at the top. */
    top: 4.25rem;
    z-index: 2;
    flex-direction: row;
    gap: 0.5rem;
    margin-inline: -1.25rem;
    padding: 0.5rem 1.25rem;
    background-color: rgb(255 255 255 / 0.86);
    backdrop-filter: blur(8px);
  }
  .svc[data-on] .svc-rail-item { flex: 1 1 0; min-width: 0; }
  .svc[data-on] .svc-row {
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    box-shadow: none;
  }
  .svc[data-on] .svc-row::before,
  .svc[data-on] .svc-row-desc,
  .svc[data-on] .svc-row-icon,
  .svc[data-on] .svc-row-arrow { display: none; }
  .svc[data-on] .svc-row-label {
    font-size: var(--text-small);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .svc[data-on] .svc-row[data-current] { transform: none; }

  /* ======================================================================
     DESKTOP, DRIVEN — the cylinder.
     ====================================================================== */
  @media (min-width: 64rem) {
    .svc-layout {
      display: grid;
      /* Rail and stage pushed well apart: the brief asked for the two halves
         to breathe, so the gutter is 5rem rather than the 3rem it was. */
      grid-template-columns: minmax(0, 26rem) minmax(0, 33rem);
      column-gap: 7rem;
      justify-content: center;
      align-items: center;
      gap: 0 5rem;
    }
    @media (min-width: 80rem) {
      .svc-layout { column-gap: 8rem; }
    }
    @media (min-width: 90rem) {
      .svc-layout { column-gap: 9rem; }
    }

    .svc-stage {
      position: relative;
      display: grid;
      place-items: center;
    }
    .svc-drum { display: grid; }
    .svc-drum > * { grid-area: 1 / 1; }

    /* Built like the product spine: a line, expanding rings, and a mark at the
       centre, all stacked in one grid cell so they share an axis. Wide enough
       to hold the rings; the line inside is still 2px. */
    .svc-spine {
      display: grid;
      place-items: center;
      position: absolute;
      inset-block: -2.5rem;
      left: 50%;
      z-index: 0;
      width: 9.75rem;
      translate: -50% 0;
      pointer-events: none;
    }
    .svc-spine > * { grid-area: 1 / 1; }

    .svc-spine-line {
      align-self: stretch;
      justify-self: center;
      width: 2px;
      border-radius: 999px;
      background-image: linear-gradient(
        to bottom,
        transparent 0%,
        rgb(255 112 0 / 0.45) 15%,
        rgb(255 143 56 / 0.85) 50%,
        rgb(255 112 0 / 0.45) 85%,
        transparent 100%
      );
      /* Was a 15rem-wide horizontal wash. A tight box-shadow on the 2px line
         instead: the core still reads as lit, without the broad haze. */
      box-shadow: 0 0 14px rgb(255 112 0 / 0.18);
    }

    /* The rings the pulse is made of. Same construction as the spiral's, at
       one and a half times the size: 9.75rem against its 6.5rem. Two of them,
       offset by half a cycle, so one is always on its way out as the next
       leaves the dot. */
    .svc-ripple {
      width: 9.75rem;
      height: 9.75rem;
      border-radius: 999px;
      /* Solid brand orange, but carried at low opacity by the keyframe. The
         colour comes from the stroke and the restraint from the animation,
         which reads calmer than a half-alpha stroke at high opacity. */
      border: 1px solid var(--color-prime-500);
      /* Outer glow only, and deliberately much wider than the stroke it
         surrounds. At these opacities the ring should register as haze moving
         outward, not as a drawn circle. */
      box-shadow: 0 0 26px 6px rgb(255 112 0 / 0.3);
      opacity: 0;
    }

    /* The dot the rings come from. */
    .svc-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 999px;
      background-color: var(--color-prime-500);
      /* Two stops rather than one: a tight, brighter core so the dot still
         reads as a solid point, and a wider spread halo matching the treatment
         the ripples carry, so the dot looks like the source the pulse leaves
         from rather than a separate mark that happens to sit there. */
      box-shadow:
        0 0 8px 1px rgb(255 112 0 / 0.55),
        0 0 22px 6px rgb(255 112 0 / 0.28);
    }
    @media (prefers-reduced-motion: no-preference) {
      /* Gated on [data-live] as well, exactly as the spiral is: no
         compositing and no battery once the section leaves the screen. */
      .svc[data-on][data-live] .svc-ripple {
        animation: svc-pulse 4.6s cubic-bezier(0.22, 0.55, 0.3, 1) infinite;
        animation-delay: var(--delay);
      }
    }

    /* The pinned half. */
    .svc[data-on] .svc-track {
      /* One viewport to hold the stage still in, plus one scroll allowance per
         step after the first. This is the whole "how long does it last". */
      min-height: calc(100vh + (var(--count) - 1) * var(--svc-scroll-per-item));
      min-height: calc(100svh + (var(--count) - 1) * var(--svc-scroll-per-item));
      padding-block: 0;
    }
    .svc[data-on] .svc-viewport {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      height: 100vh;
      height: 100svh;
    }

    .svc[data-on] .svc-menu { display: block; }

    /* The rail keeps its full card form on desktop — the mobile pill styling
       above is scoped below this breakpoint by being overridden here. */
    .svc[data-on] .svc-rail {
      position: static;
      flex-direction: column;
      gap: 0.875rem;
      margin-inline: 0;
      padding: 0;
      background-color: transparent;
      backdrop-filter: none;
    }
    .svc[data-on] .svc-row { gap: 0.875rem; padding: 1.0625rem 1.25rem; box-shadow: 0 6px 16px -12px rgb(8 9 11 / 0.22); }
    .svc[data-on] .svc-row::before,
    .svc[data-on] .svc-row-desc,
    .svc[data-on] .svc-row-icon,
    .svc[data-on] .svc-row-arrow { display: flex; }
    .svc[data-on] .svc-row::before { display: block; }
    .svc[data-on] .svc-row-desc { display: block; }
    .svc[data-on] .svc-row-label { font-size: var(--text-h4); white-space: normal; }
    .svc[data-on] .svc-row[data-current] { transform: translateY(-2px); }

    /* --- the drum ---
       `--p` is the only thing the driver writes: scroll progress, 0 to 1.
       `--k` turns that into a position along the row of displays, and each
       panel derives its own angle from the difference between where it sits
       and where the drum has turned to. Three panels, one write. */
    .svc[data-on] .svc-drum {
      --k: calc(var(--p, 0) * (var(--count) - 1));
    }
    .svc[data-on] .svc-panel {
      --a: calc((var(--i) - var(--k)) * var(--svc-arc-pitch));
      position: relative;
      z-index: 1;
      backface-visibility: hidden;
      pointer-events: none;
      transform:
        perspective(var(--svc-persp))
        translateZ(calc(var(--svc-radius) * -1))
        rotateY(var(--a))
        translateZ(var(--svc-radius));
    }
    /* Fades with the cosine of its own angle, so a panel is solid facing front
       and gone by the time it is edge-on. Continuous with scroll rather than
       stepped, which is what makes the turn read as one moving body. */
    @supports (opacity: cos(0deg)) {
      .svc[data-on] .svc-panel { opacity: max(0, cos(var(--a))); }
    }
    /* Only the display actually facing the reader takes a click. */
    .svc[data-on] .svc-panel[data-current] { pointer-events: auto; }
  }

  /* Departs from the spiral's curve in two ways, both for smoothness.
     The spiral starts at full opacity, so its ring pops into existence; this
     one fades up over the first tenth instead. And where the spiral cuts to
     zero at 70% and then keeps growing invisibly, this one fades the whole way
     out, so there is no step in the middle of the travel. */
  @keyframes svc-pulse {
    0% { transform: scale(0.35); opacity: 0; }
    12% { opacity: 0.17; }
    55% { opacity: 0.08; }
    100% { transform: scale(2.4); opacity: 0; }
  }
</style>

<script>
  /**
   * Services driver. Same discipline as the product spiral: a deferred module
   * that does nothing until the section is near the viewport, then one rect
   * read and one custom-property write per frame.
   *
   * Two modes, one attribute. On desktop it maps scroll progress onto the
   * drum's rotation; on a phone it watches which display is on screen. Both
   * set `data-current`, so the highlight styling is written once.
   */
  interface Driver {
    stop: () => void;
  }

  const REDUCE = '(prefers-reduced-motion: reduce)';
  const DESKTOP = '(min-width: 64rem)';

  const init = (root: HTMLElement): Driver | null => {
    const track = root.querySelector<HTMLElement>('[data-svc-track]');
    const drum = root.querySelector<HTMLElement>('[data-svc-drum]');
    const pinned = root.querySelector<HTMLElement>('.svc-viewport');
    const links = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-link]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-item]'));
    const count = links.length;
    if (!track || !drum || !pinned || count < 2) return null;

    root.dataset.on = '';

    let frame = 0;
    let live = false;
    let current = -1;
    const wide = window.matchMedia(DESKTOP);

    const setCurrent = (index: number) => {
      if (index === current) return;
      links[current]?.removeAttribute('data-current');
      panels[current]?.removeAttribute('data-current');
      links[index]?.setAttribute('data-current', '');
      panels[index]?.setAttribute('data-current', '');
      current = index;
      /* Only the display facing the reader is reachable by keyboard. The other
         two are turned away and must not be tab stops. */
      panels.forEach((panel, i) => panel.toggleAttribute('inert', i !== index));
    };

    /* ---------------------------------------------------------- desktop */
    const update = () => {
      frame = 0;
      const rect = track.getBoundingClientRect();
      /* Measure the pinned element rather than innerHeight: on a phone
         innerHeight changes as the URL bar hides while the stage, sized in
         svh, does not — dividing by it would make progress drift. */
      const span = rect.height - pinned.offsetHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -rect.top / span)) : 0;
      drum.style.setProperty('--p', p.toFixed(4));
      setCurrent(Math.round(p * (count - 1)));
    };

    const schedule = () => {
      if (!frame && live && wide.matches) frame = requestAnimationFrame(update);
    };

    const listen = (on: boolean) => {
      const fn = on ? window.addEventListener : window.removeEventListener;
      fn('scroll', schedule, { passive: true });
      fn('resize', schedule, { passive: true });
    };

    const activity = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting === live) return;
        live = entry.isIntersecting;
        root.toggleAttribute('data-live', live);
        listen(live);
        if (live) schedule();
        else if (frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      },
      { rootMargin: '15% 0px' },
    );
    activity.observe(track);

    /* ----------------------------------------------------------- mobile
       Whichever display is nearest the middle of the screen owns the pills.
       An observer rather than a scroll handler: no per-frame work at all. */
    const centred = new IntersectionObserver(
      (entries) => {
        if (wide.matches) return;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = panels.indexOf(entry.target as HTMLElement);
          if (index >= 0) setCurrent(index);
        }
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );
    panels.forEach((panel) => centred.observe(panel));

    const onWidthChange = () => {
      if (wide.matches) {
        schedule();
      } else {
        /* Leaving desktop: drop the rotation and let every display stand up
           again, all of them reachable. */
        drum.style.removeProperty('--p');
        panels.forEach((panel) => panel.removeAttribute('inert'));
      }
    };
    wide.addEventListener('change', onWidthChange);
    onWidthChange();

    return {
      stop() {
        activity.disconnect();
        centred.disconnect();
        wide.removeEventListener('change', onWidthChange);
        listen(false);
        if (frame) cancelAnimationFrame(frame);
        root.removeAttribute('data-on');
        root.removeAttribute('data-live');
        drum.style.removeProperty('--p');
        links[current]?.removeAttribute('data-current');
        panels[current]?.removeAttribute('data-current');
        panels.forEach((panel) => panel.removeAttribute('inert'));
        current = -1;
      },
    };
  };

  const motion = window.matchMedia(REDUCE);
  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-svc]'));
  let running: Driver[] = [];

  const start = () => {
    if (motion.matches || running.length) return;
    running = roots.map(init).filter((d): d is Driver => d !== null);
  };
  const stop = () => {
    running.forEach((d) => d.stop());
    running = [];
  };

  /* Honour a preference change mid-visit in both directions. */
  motion.addEventListener('change', (e) => (e.matches ? stop() : start()));
  start();
</script>
