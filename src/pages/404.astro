---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { products, services } from '../data/navigation.ts';

const suggestions = [...products.slice(0, 3), ...services.filter((s) => !s.external)];
---

<BaseLayout
  title="Page not found | PrimeTrack Telematics"
  description="The page you were looking for could not be found. Browse PrimeTrack's tracking products and fleet services instead."
  indexable={false}
>
  <Section tone="white" size="lg">
    <div class="flex max-w-2xl flex-col gap-6">
      <span class="eyebrow">Error 404</span>
      <h1 class="text-display text-ink-950">We could not find that page</h1>
      <p class="text-lead text-ink-600 text-pretty">
        The link may be out of date, or the address may have been mistyped. Everything PrimeTrack
        offers is one step away below.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href="/" size="lg">
          Back to home
          <Icon name="arrow-right" size={18} />
        </Button>
        <Button href="/contact-prime/" variant="secondary" size="lg">Contact us</Button>
      </div>
    </div>

    <ul class="mt-14 grid gap-x-8 gap-y-4 border-t border-ink-200 pt-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        suggestions.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex min-h-11 items-center gap-2 text-body font-semibold text-ink-900 transition-colors hover:text-prime-700"
            >
              <Icon name="arrow-right" size={16} class="text-prime-600" />
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
