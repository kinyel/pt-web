---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProductSpiral from '../components/ProductSpiral.astro';
import ServiceConsole from '../components/ServiceConsole.astro';
import StatBand from '../components/StatBand.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import HeroMap from '../components/HeroMap.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import { Image } from 'astro:assets';
import { media } from '../data/media.ts';
import { company, descriptors, credentials, certificatesPdf } from '../data/company.ts';

/**
 * Homepage capability blurbs — the feature set the live homepage advertises
 * (inventory §5). Nothing added, nothing embellished.
 */
const capabilities = [
  {
    icon: 'smartphone',
    title: 'Track vehicles on the go',
    body: 'Native iOS and Android apps put live vehicle positions in your pocket.',
  },
  {
    icon: 'wrench',
    title: 'Fleet preventive maintenance',
    body: 'Automated service and renewal scheduling, so nothing lapses unnoticed.',
  },
  {
    icon: 'gauge',
    title: 'Driver behaviour monitoring',
    body: 'Identify risky habits before they become incidents or fuel losses.',
    href: '/driver-behaviour-monitoring-systems-for-vehicle-fleet-management/',
  },
  {
    icon: 'siren',
    title: 'Arrive Alive speed limiters',
    body: 'PrimeTrack is an FRSC-licensed Speed Limiter vendor.',
  },
  {
    icon: 'video',
    title: 'Ai-PRIME video telematics',
    body: 'AI-analysed video that coaches drivers in real time and evidences incidents.',
    href: '/vehicle-video-tracking-systems/',
  },
  {
    icon: 'fuel',
    title: 'Fuel consumption monitoring',
    body: 'See where fuel actually goes and what it costs you.',
    href: '/fleet-fuel-consumption-management-system/',
  },
  {
    icon: 'plug',
    title: 'Prime API integration',
    body: 'Push telematics data straight into the systems you already run.',
    href: '/gps-telematics-api-integrations/',
  },
];

/** Three of the seven advantages (inventory §6.1); the page carries all seven. */
const advantages = [
  {
    icon: 'shield-check',
    title: 'Regulator-approved',
    body: 'NCC-licensed to provide GPS tracking and telematics in Nigeria. Many competitors are not.',
  },
  {
    icon: 'headset',
    title: 'PrimeCARE, 24/7',
    body: 'Round-the-clock human support, with proactive monitoring that catches anomalies before you do.',
  },
  {
    icon: 'layers',
    title: 'Built for African conditions',
    body: 'Rugged hardware engineered for heat, dust, humidity and variable network coverage.',
  },
];

const title = "PrimeTrack Telematics | Nigeria's #1 GPS Tracking & Fleet Management";
const description =
  'GPS vehicle tracking, Ai-enabled video telematics, solar trackers and fleet management in Nigeria. NCC-licensed, 24/7 PrimeCARE support, 3-year warranty.';
---

<BaseLayout title={title} description={description}>
  <!-- ================= HERO ================= -->
  <section class="on-dark relative overflow-hidden bg-ink-950">
    <!-- Animated route/telemetry drawing. It draws its own coordinate grid, so
         the .bg-grid-prime layer is omitted here to avoid two grids moiring
         against each other. -->
    <HeroMap />
    <div class="bg-prime-glow pointer-events-none absolute inset-0"></div>

    <div class="container-prime relative py-14 md:py-20">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div class="flex flex-col gap-7">
          <span class="eyebrow">{company.positioning}</span>

          <h1 class="text-display-xl text-white">
            Efficient telematics<br class="hidden sm:block" /> is here
          </h1>

          <p class="max-w-xl text-lead text-ink-300 text-pretty">
            Precision vehicle tracking, Ai-enabled video telematics and IoT-driven fleet management
            for Nigerian businesses, backed by 24/7 PrimeCARE support and a 3-year warranty.
          </p>

          <div class="flex flex-col gap-3 sm:flex-row">
            <Button href="/contact-prime/" size="lg">
              Talk to our team
              <Icon name="arrow-right" size={18} />
            </Button>
            <Button href="/fleet-analytics/" variant="secondary" tone="dark" size="lg">
              See what we track
            </Button>
          </div>

          <ul class="flex flex-wrap gap-x-6 gap-y-3 pt-2">
            {
              ['NCC-licensed', 'FRSC-licensed Speed Limiter vendor', '3-year warranty'].map(
                (item) => (
                  <li class="flex items-center gap-2 text-small text-ink-300">
                    <Icon name="circle-check" size={16} class="text-prime-500" />
                    {item}
                  </li>
                ),
              )
            }
          </ul>
        </div>

        <!-- Visual composition: real photography slot + a credential panel.
             No invented dashboard or fake product UI. -->
        <div class="relative">
          <MediaPlaceholder
            slot="hero-fleet-photography"
            src="/fleet-tracking-road.jpeg"
            alt="Fleet of tracked trucks driving on a road"
            tone="dark"
            class="max-h-[20rem] lg:max-h-[23rem] lg:max-w-[25rem]"
          />

          <div
            class="mt-4 rounded-panel border border-white/10 bg-ink-900/80 p-5 backdrop-blur sm:absolute sm:-bottom-6 sm:-left-6 sm:mt-0 sm:max-w-xs"
          >
            <p class="text-label uppercase text-prime-400">Operating since</p>
            <p class="mt-1 font-display text-h3 text-white">15+ years in telematics</p>
            <p class="mt-2 text-small text-ink-400">
              Nigeria, Rwanda, Egypt and beyond. 5 countries in operation.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Capability descriptor band -->
    <div class="relative border-t border-white/10">
      <ul class="container-prime flex flex-wrap items-center gap-x-8 gap-y-3 py-5">
        {
          descriptors.map((descriptor) => (
            <li class="flex items-center gap-2 text-small text-ink-400">
              <span class="h-1.5 w-1.5 rounded-full bg-prime-500" />
              {descriptor}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <Section tone="ink" size="sm">
    <StatBand tone="dark" />
  </Section>

  <!-- ================= PRODUCTS =================
       The products section is the scroll-driven spiral. It keeps id="products"
       because /#products is the Products breadcrumb target on every product
       page and is linked from the header.

       On reveals elsewhere: the hero is deliberately left alone. Fading in the
       H1 or the hero photograph would delay Largest Contentful Paint by the
       length of the transition, and the first thing a visitor sees should be
       there when they get there. Motion starts below the fold. -->
  <ProductSpiral id="products" />

  <!-- ================= SERVICES =================
       The three software services, as an interactive console. Runs cooler and
       flatter than the spiral above on purpose; see the note in the component.
       The standalone "Explore fleet analytics" button that used to sit beside
       the heading is gone: Fleet Analytics is now one of the three rows, so the
       button was a second link to the same page. -->
  <ServiceConsole id="services" />

  <!-- ================= WHY PRIMETRACK ================= -->
  <Section tone="dark">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <SectionHeader
        class="reveal"
        eyebrow="Why PrimeTrack"
        tone="dark"
        title="Why fleets trust us with their vehicles"
        lead="Seven advantages separate PrimeTrack from the field. Three of them matter before you even switch a device on."
      />

      <div class="flex flex-col gap-8">
        <ul class="flex flex-col divide-y divide-white/10" data-reveal-stagger="80">
          {
            advantages.map((advantage) => (
              <li class="reveal flex gap-5 py-6 first:pt-0">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/10 text-prime-400">
                  <Icon name={advantage.icon} size={20} />
                </span>
                <div>
                  <h3 class="text-h4 text-white">{advantage.title}</h3>
                  <p class="mt-1.5 text-small text-ink-400 text-pretty">{advantage.body}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <Button
          href="/why-choose-primetrack/"
          variant="secondary"
          tone="dark"
          class="reveal self-start"
        >
          See all seven advantages
          <Icon name="arrow-right" size={16} />
        </Button>
      </div>
    </div>
  </Section>

  <!-- ================= CAPABILITIES ================= -->
  <Section tone="white">
    <SectionHeader
      class="reveal"
      eyebrow="Capabilities"
      title="What you get, day to day"
      lead="The everyday features PrimeTrack customers rely on across Nigeria."
    />

    <ul
      class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3"
      data-reveal-stagger="60"
    >
      {
        capabilities.map((capability) => (
          <li class="reveal flex flex-col gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-card bg-ink-950 text-prime-400">
              <Icon name={capability.icon} size={18} />
            </span>
            <h3 class="text-h4 text-ink-950">{capability.title}</h3>
            <p class="text-small text-ink-600 text-pretty">{capability.body}</p>
            {capability.href && (
              <a
                href={capability.href}
                class="group/link inline-flex items-center gap-1.5 text-small font-semibold text-prime-700 transition-colors duration-[var(--duration-fast)] hover:text-prime-800"
              >
                Learn more<span class="sr-only"> about {capability.title.toLowerCase()}</span>
                <Icon
                  name="arrow-right"
                  size={15}
                  class="transition-transform duration-[var(--duration-base)] ease-[var(--ease-prime)] group-hover/link:translate-x-0.5"
                />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ================= CREDENTIALS ================= -->
  <Section tone="tinted">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <SectionHeader
        class="reveal"
        eyebrow="Credentials"
        title="Licensed, accountable, and here when you call"
        lead="Every claim on this page is one we can evidence, paperwork included."
      />

      <div class="flex flex-col gap-5" data-reveal-stagger="70">
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            credentials.map((credential) => (
              <li class="reveal rounded-panel border border-ink-200 bg-white p-6">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-prime-50 text-prime-600">
                  <Icon name="badge-check" size={19} />
                </span>
                <h3 class="mt-4 text-h4 text-ink-950">{credential.title}</h3>
                <p class="mt-1.5 text-small text-ink-600 text-pretty">{credential.body}</p>
              </li>
            ))
          }
        </ul>

        <div class="reveal flex flex-col gap-4 rounded-panel border border-ink-200 bg-white p-6">
          <p class="text-label uppercase text-ink-500">Regulatory bodies</p>
          {/* The client's own accreditation artwork, reproduced as published.
              No accreditation is asserted in copy beyond what §6.2 of the
              content inventory verifies — see the note in data/media.ts. */}
          <Image
            src={media.accreditations.image}
            alt={media.accreditations.alt}
            width={180}
            height={58}
            loading="lazy"
            class="h-auto w-[180px] max-w-full"
          />
          {/* Rendered at its native 180px. The source is the only version the
              client publishes, so a 2× render would just be upscaling. */}
          <a
            href={certificatesPdf.href}
            class="inline-flex items-center gap-2 self-start text-small font-semibold text-prime-700 transition-colors duration-[var(--duration-fast)] hover:text-prime-800"
          >
            <Icon name="file-text" size={16} />
            {certificatesPdf.label}
          </a>
        </div>
      </div>
    </div>
  </Section>

  <CTA />
</BaseLayout>
