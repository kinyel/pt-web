---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbSchema } from '../data/schema.ts';

const title = 'Prime Warranties — 3-Year Product Warranty | PrimeTrack';
const description =
  'PrimeTrack products carry a 3-year warranty from date of purchase for the original purchaser, covering defects in materials and workmanship.';

/** Warranty policy (inventory §6.2). The duration is three years — never "lifetime". */
const covered = [
  'Defects in materials and workmanship under normal use',
  'Products bought through authorized PrimeTrack channels',
  'Service carried out by PrimeTrack or authorized personnel',
];

const excluded = [
  'Accidental damage occurring after installation',
  'Tampering with the device or its installation',
  'Repair or service by unauthorized personnel',
  'Fire, earthquake, power surge or vehicle power failure',
  'Force majeure events',
  'Sabotage',
];
---

<BaseLayout
  title={title}
  description={description}
  schemas={[breadcrumbSchema([{ label: 'Prime Warranties', href: '/warranty/' }])]}
>
  <PageHero
    icon="shield-check"
    eyebrow="Prime Warranties"
    title="A 3-year warranty, stated plainly"
    lead="Three years from date of purchase, for the original purchaser — one of the longest warranties in the industry, with terms you can read in a minute."
    chips={['3 years from purchase', 'Original purchaser', 'Non-transferable']}
    crumbs={[{ label: 'Prime Warranties' }]}
    showCta={false}
  />

  <Section tone="white">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <SectionHeader
        eyebrow="Duration"
        title="Three years, from the date of purchase"
        lead="The warranty runs for three (3) years from date of purchase and applies to the original purchaser only. It is non-transferable and terminates on resale of the product."
      />

      <div class="grid gap-5 sm:grid-cols-2">
        <div class="rounded-panel border border-ink-200 bg-white p-6">
          <h2 class="flex items-center gap-2 text-h4 text-ink-950">
            <Icon name="circle-check" size={19} class="text-prime-600" />
            What is covered
          </h2>
          <ul class="mt-4 flex flex-col gap-3">
            {
              covered.map((item) => (
                <li class="flex gap-2.5 text-small text-ink-600">
                  <Icon name="check" size={16} class="mt-0.5 shrink-0 text-prime-600" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-panel border border-ink-200 bg-white p-6">
          <h2 class="flex items-center gap-2 text-h4 text-ink-950">
            <Icon name="shield" size={19} class="text-ink-500" />
            What is excluded
          </h2>
          <ul class="mt-4 flex flex-col gap-3">
            {
              excluded.map((item) => (
                <li class="flex gap-2.5 text-small text-ink-600">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-400" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="tinted" size="sm">
    <div class="prose-prime max-w-3xl text-ink-600">
      <h2 class="text-h3 text-ink-950">Conditions</h2>
      <p>
        The warranty covers defects in materials and workmanship under normal use. It applies only
        to products purchased through authorized PrimeTrack channels, and servicing must be carried
        out by PrimeTrack or personnel we have authorized.
      </p>
      <p>
        Cover is non-transferable. If the product is resold, the warranty terminates at the point of
        resale.
      </p>
      <p>
        Need to make a claim or check whether your device is still in cover?{' '}
        <a href="/contact-prime/">Contact our team</a> with your purchase details.
      </p>
    </div>
  </Section>

  <CTA
    title="Questions about cover on a device you already own?"
    lead="Send us the purchase details and we will confirm the warranty status and next steps."
  />
</BaseLayout>
