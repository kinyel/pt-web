---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatBand from '../components/StatBand.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { primeValues, certificatesPdf } from '../data/company.ts';
import { breadcrumbSchema } from '../data/schema.ts';

const title = 'Why Choose PrimeTrack | 7 Advantages | PrimeTrack Telematics';
const description =
  'NCC-licensed, 24/7 PrimeCARE support, rugged hardware for African conditions, Ai-driven telematics and one of the longest warranties in the industry.';

/** The seven advantages, in the order the company states them (inventory §6.1). */
const advantages = [
  {
    icon: 'badge-check',
    title: 'Regulator-approved',
    body: 'PrimeTrack is licensed by the Nigerian Communications Commission to provide GPS tracking and telematics services in Nigeria, a bar many competitors in this market do not clear.',
  },
  {
    icon: 'headset',
    title: 'PrimeCARE, 24 hours a day',
    body: 'Round-the-clock human support, backed by proactive monitoring that watches for anomalies on your account rather than waiting for you to report them.',
  },
  {
    icon: 'shield',
    title: 'Rugged hardware for African environments',
    body: 'Devices built for the conditions they actually operate in: heat, dust, humidity, and network coverage that varies from one state to the next.',
  },
  {
    icon: 'cpu',
    title: 'Ai-driven telematics',
    body: 'Fuel optimisation, driver scoring and predictive maintenance delivered through interfaces simple enough for the people who have to use them daily.',
  },
  {
    icon: 'shield-check',
    title: 'Long warranty and after-sales support',
    body: 'A 3-year warranty, one of the longest in the industry, with quick mean-time-to-repair when something does need attention.',
  },
  {
    icon: 'plug',
    title: 'Integrations and architecture that scale',
    body: 'Open APIs, modular design and iVTS compatibility, running the same way whether you operate 3 vehicles or 3,000.',
  },
  {
    icon: 'target',
    title: 'Core values: P.R.I.M.E.',
    body: 'Performance, Reliability, Innovation, Multifunctionality and Efficiency. We hold every deployment to that standard.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schemas={[breadcrumbSchema([{ label: 'Why Choose PrimeTrack', href: '/why-choose-primetrack/' }])]}
>
  <PageHero
    icon="shield-check"
    eyebrow="Why PrimeTrack"
    title="Seven reasons fleets choose PrimeTrack"
    lead="Trusting a company with your vehicles, cargo and people is a serious decision. Here is what we put behind it."
    crumbs={[{ label: 'Why Choose PrimeTrack' }]}
  />

  <Section tone="ink" size="sm">
    <StatBand tone="dark" />
  </Section>

  <Section tone="white">
    <ol class="flex flex-col divide-y divide-ink-200">
      {
        advantages.map((advantage, i) => (
          <li class="reveal grid gap-5 py-9 first:pt-0 md:grid-cols-[5rem_1fr] md:gap-10">
            <div class="flex items-center gap-4 md:flex-col md:items-start md:gap-3">
              <span class="font-display text-h2 leading-none text-ink-200">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-prime-50 text-prime-600">
                <Icon name={advantage.icon} size={20} />
              </span>
            </div>
            <div class="max-w-3xl">
              <h2 class="text-h3 text-ink-950">{advantage.title}</h2>
              <p class="mt-3 text-body text-ink-600 text-pretty">{advantage.body}</p>
              {i === 4 && (
                <a
                  href="/warranty/"
                  class="mt-4 inline-flex items-center gap-1.5 text-small font-semibold text-prime-700 hover:text-prime-800"
                >
                  Read the warranty terms
                  <Icon name="arrow-right" size={15} />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section tone="tinted">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <SectionHeader
        eyebrow="P.R.I.M.E."
        title="The values behind the name"
        lead="Five commitments that decide how we build, deploy and support every system."
      />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          primeValues.map((value) => (
            <li class="rounded-panel border border-ink-200 bg-white p-6">
              <span class="font-display text-stat leading-none text-prime-500">{value.letter}</span>
              <p class="mt-3 text-h4 text-ink-950">{value.word}</p>
            </li>
          ))
        }
        <li class="flex flex-col justify-center rounded-panel border border-dashed border-ink-300 p-6">
          <a
            href={certificatesPdf.href}
            class="inline-flex items-center gap-2 text-small font-semibold text-prime-700 hover:text-prime-800"
          >
            <Icon name="file-text" size={16} />
            {certificatesPdf.label}
          </a>
        </li>
      </ul>
    </div>
  </Section>

  <CTA />
</BaseLayout>
