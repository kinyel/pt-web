---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContactForm from '../components/ContactForm.tsx';
import Icon from '../components/Icon.astro';
import { contact, countries, socials } from '../data/company.ts';
import { products, services } from '../data/navigation.ts';
import { breadcrumbSchema } from '../data/schema.ts';

const title = 'Contact PrimeTrack Telematics — Ikeja, Lagos | PrimeTrack';
const description =
  '4th Floor, L’Monarch Towers, 65C Opebi Road, Ikeja, Lagos. Call +234 803 060 9099 or email admin@primetracknigeria.net.';

/** Set PUBLIC_WEB3FORMS_KEY in the deploy environment to activate the form. */
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

const interests = [...products, ...services.filter((s) => !s.external)].map((item) => item.label);

const rwanda = countries.find((c) => c.code === 'RWA')!;
const { lat, lng, label } = contact.map;
const mapSrc = `https://www.google.com/maps?q=${lat},${lng}&hl=en&z=16&output=embed`;
---

<BaseLayout
  title={title}
  description={description}
  schemas={[breadcrumbSchema([{ label: 'Contact', href: '/contact-prime/' }])]}
>
  <PageHero
    icon="headset"
    eyebrow="Contact"
    title="Talk to PrimeTrack"
    lead="Tell us what you move — vehicles, cargo or people — and we will walk you through the right setup. Our Lagos office answers, and PrimeCARE support runs 24/7."
    crumbs={[{ label: 'Contact' }]}
    showCta={false}
  />

  <Section tone="white">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <SectionHeader
          eyebrow="Send a message"
          title="Start the conversation"
          lead="Fill this in and our team will come back to you. For anything urgent, call — it is faster."
          class="mb-8"
        />
        <ContactForm
          client:visible
          accessKey={accessKey}
          interests={interests}
          recipientEmail={contact.email}
        />
      </div>

      <div class="flex flex-col gap-8">
        <div class="rounded-panel border border-ink-200 bg-white p-6 md:p-8">
          <h2 class="text-h3 text-ink-950">Nigeria office</h2>

          <address class="mt-5 flex flex-col gap-4 not-italic">
            <p class="flex gap-3 text-body text-ink-700">
              <Icon name="map-pin" size={19} class="mt-1 shrink-0 text-prime-600" />
              <span>
                {contact.addressLines.map((line) => (<>{line}<br /></>))}
              </span>
            </p>

            {
              contact.phones.map((phone) => (
                <a
                  href={`tel:${phone.tel}`}
                  class="flex min-h-11 items-center gap-3 text-body text-ink-700 transition-colors hover:text-prime-700"
                >
                  <Icon name="phone" size={19} class="shrink-0 text-prime-600" />
                  {phone.display}
                </a>
              ))
            }

            <a
              href={`mailto:${contact.email}`}
              class="flex min-h-11 items-center gap-3 break-all text-body text-ink-700 transition-colors hover:text-prime-700"
            >
              <Icon name="mail" size={19} class="shrink-0 text-prime-600" />
              {contact.email}
            </a>
          </address>

          <div class="mt-6 border-t border-ink-200 pt-6">
            <p class="text-label uppercase text-ink-500">Other offices</p>
            <a
              href={rwanda.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex min-h-11 items-center gap-2 text-body text-ink-700 transition-colors hover:text-prime-700"
            >
              <Icon name="globe" size={18} class="text-prime-600" />
              PrimeTrack Rwanda
              <Icon name="external-link" size={14} class="text-ink-400" />
            </a>
          </div>

          <div class="mt-6 border-t border-ink-200 pt-6">
            <p class="text-label uppercase text-ink-500">Follow PrimeTrack</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {
                socials.map((social) => (
                  <li>
                    <a
                      href={social.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-11 items-center rounded-full border border-ink-200 px-4 py-2 text-small font-semibold text-ink-700 transition-colors hover:border-prime-400 hover:text-prime-700"
                    >
                      {social.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="overflow-hidden rounded-panel border border-ink-200">
          <iframe
            src={mapSrc}
            title={`Map showing ${label}`}
            width="100%"
            height="340"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            style="border:0; display:block;"
          ></iframe>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
